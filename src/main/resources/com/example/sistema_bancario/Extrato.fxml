                  <Font size="25.0" />
               </font>
            </Label>
            <Label fx:id="saldoAtualValor" layoutX="19.0" layoutY="54.0" styleClass="extract-value" stylesheets="@../../../css/extrato.css" text="R$ 5.530,88" textFill="#f2eded">
