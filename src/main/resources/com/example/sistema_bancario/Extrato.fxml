<AnchorPane id="fundoExtrato" fx:id="valorRecebidoSilva" prefHeight="700.0" prefWidth="1280.0" styleClass="root" stylesheets="@../../../css/tela_inicio.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sistema_bancario.controller.ServicosController.ExtratoController">
   <children>
      <Label fx:id="tituloExtrato" layoutX="275.0" layoutY="25.0" styleClass="extract-title" stylesheets="@../../../css/extrato.css" text="Extrato" textFill="WHITE">
         <font>
            <Font name="Webdings" size="48.0" />
         </font>
      </Label>
      <AnchorPane fx:id="cardSaldoAtual" layoutX="275.0" layoutY="141.0" prefHeight="125.0" prefWidth="965.0" styleClass="extract-card" stylesheets="@../../../css/extrato.css">
